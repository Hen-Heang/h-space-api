# Template for deploy/.env on the server - copy it, fill it in, never commit
# the copy (.env is git-ignored):
#   cp prod.env.example .env && chmod 600 .env
#
# Every value below is a placeholder. Leave a line out rather than setting it
# to empty: an empty value overrides the app's built-in default (see
# docs/build-and-run.md).

# ---- Required ----

# Image to run, pinned by digest (CI's run summary prints the reference).
API_IMAGE=ghcr.io/hen-heang/h-space-api/security-api@sha256:REPLACE_WITH_DIGEST

# Public hostname of the API; its DNS A record must point at this server.
API_DOMAIN=api.example.com
# Let's Encrypt contacts this address about certificate problems.
ACME_EMAIL=you@example.com

# ---- Database (external: Neon or Supabase) ----
# JDBC format: jdbc:postgresql://HOST:PORT/DATABASE?sslmode=require
# Not the postgresql://user:pass@... URI the dashboard shows first - copy the
# host and database name out of it, and put user/password in the two lines
# below. Use a session-capable endpoint: Flyway runs migrations through this
# same connection at startup (see docs/deploy-vps.md, "Choosing the database
# endpoint").
#
# Neon - the direct endpoint (host WITHOUT "-pooler"):
DB_URL=jdbc:postgresql://ep-example-123456.REGION.aws.neon.tech:5432/neondb?sslmode=require
DB_USERNAME=neondb_owner
#
# Supabase - the session pooler on port 5432 (IPv4), NOT the transaction
# pooler on 6543; or the direct db.PROJECT_REF.supabase.co:5432 if this
# server has IPv6:
# DB_URL=jdbc:postgresql://aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# DB_USERNAME=postgres.PROJECT_REF
#
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD

# Connection pool (defaults shown). Keep max * number of app instances below
# the provider's connection limit.
# DB_POOL_MAX_SIZE=5
# DB_POOL_MIN_IDLE=1

# ---- Secrets generated on the server ----
# JWT signing key, Base64 of at least 64 bytes: openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=REPLACE_WITH_GENERATED_VALUE
# AES-256 key for TOTP secrets, Base64 of 32 bytes: openssl rand -base64 32
# Don't change it once users have enabled MFA - their secrets can't be
# decrypted with a different key.
MFA_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_VALUE

# Web app origin(s) allowed to call the API (CORS), comma-separated.
CORS_ALLOWED_ORIGINS=https://app.example.com
# Where links in emails (verify email, unlock account, ...) point.
FRONTEND_URL=https://app.example.com

# ---- Email (verification, password reset, sign-in codes) ----
# Gmail SMTP: use an app password, not the account password.
MAIL_USERNAME=you@example.com
MAIL_PASSWORD=REPLACE_WITH_APP_PASSWORD

# ---- Accounts ----
# This email becomes the admin once verified, and can always sign up.
OWNER_EMAIL=you@example.com
# invite-only (default) or open.
# SIGNUP_MODE=invite-only

# ---- Optional ----
# API container memory limit; the JVM heap is 60% of it.
# API_MEM_LIMIT=768m

# Run Flyway through a different endpoint than the app (e.g. app on Neon's
# pooler, migrations direct). Include sslmode in this URL too - the prod
# pool's TLS default doesn't apply to Flyway's own connection.
# SPRING_FLYWAY_URL=jdbc:postgresql://DIRECT_HOST:5432/DATABASE?sslmode=require
# SPRING_FLYWAY_USER=REPLACE
# SPRING_FLYWAY_PASSWORD=REPLACE

# Google sign-in: comma-separated OAuth client IDs. Leave out to disable.
# GOOGLE_CLIENT_IDS=

# Swagger UI / OpenAPI spec are off in prod. true turns them on - only
# temporarily, then remove the line and `up -d` again.
# API_DOCS_ENABLED=true

# Temporary Supabase bridge - see docs/security-api-state.md. Leave out to
# disable (the endpoint answers 503).
# SUPABASE_URL=
# SUPABASE_JWT_SECRET=
# SUPABASE_SERVICE_ROLE_KEY=
